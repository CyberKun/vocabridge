@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vocab: <https://example.org/vocabridge/procurement#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/procurement/shapes/InvoiceShape> a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "From source field 'payee_ref'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "billed by" ;
            sh:nodeKind sh:IRI ;
            sh:path vocab:billedBy ],
        [ sh:datatype xsd:string ;
            sh:description "From source field 'currency'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "currency code" ;
            sh:path vocab:currencyCode ],
        [ sh:datatype xsd:date ;
            sh:description "From source field 'issued_on'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "invoice date" ;
            sh:path vocab:invoiceDate ],
        [ sh:datatype xsd:decimal ;
            sh:description "From source field 'amount_due'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "amount due" ;
            sh:path vocab:amountDue ],
        [ sh:datatype xsd:string ;
            sh:description "From source field 'invoice_number'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "invoice number" ;
            sh:path vocab:invoiceNumber ],
        [ sh:description "From source field 'po_ref'" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "bills order" ;
            sh:nodeKind sh:IRI ;
            sh:path vocab:billsOrder ] ;
    sh:targetClass vocab:Invoice .

